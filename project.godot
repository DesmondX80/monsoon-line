; Engine configuration file.
; Godot 4.x project for Monsoon Line.

config_version=5

[application]

config/name="Monsoon Line"
config/description="Taktinen yksinpelattava FPS. Operaatio Junction City, Vietnam 1967."
run/main_scene="res://world/levels/test_range.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameState="*res://autoload/game_state.gd"
AudioDirector="*res://autoload/audio_director.gd"
SaveManager="*res://autoload/save_manager.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

